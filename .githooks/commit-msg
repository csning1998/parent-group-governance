#!/bin/sh
# Validates commit messages against Conventional Commits using the reviewer container image.
# Activation: git config core.hooksPath .githooks

set -e

MSG_FILE="$1"
REPO_ROOT="$(git rev-parse --show-toplevel)"

# The image follows the GitLab host and top-level group of origin and the reviewer tag of .gitlab-ci.yml.
# The registry host assumes the registry.<GitLab host> convention, and REVIEWER_IMAGE overrides the whole reference.
origin="$(git remote get-url origin)"
case "${origin}" in
    *://*)
        authority_path="${origin#*://}"
        host="${authority_path%%/*}"
        host="${host##*@}"
        host="${host%%:*}"
        project_path="${authority_path#*/}"
        ;;
    *)
        host="${origin#*@}"
        host="${host%%:*}"
        project_path="${origin#*:}"
        ;;
esac
top_level_group="${project_path%%/*}"
reviewer_tag="$(sed -n 's|.*reviewer_image: .*/reviewer:\([0-9][0-9.]*\).*|\1|p' "${REPO_ROOT}/.gitlab-ci.yml" | head -n 1)"
if [ -z "${REVIEWER_IMAGE:-}" ] && [ -z "${reviewer_tag}" ]; then
    echo "commit-msg: .gitlab-ci.yml declares no reviewer_image tag, set REVIEWER_IMAGE." >&2
    exit 1
fi
IMAGE="${REVIEWER_IMAGE:-registry.${host}/${top_level_group}/gitlab-ci-with-code-reviewer/reviewer:${reviewer_tag}}"

# Relabel .git for container access when SELinux is enforcing.
if command -v selinuxenabled >/dev/null 2>&1 && selinuxenabled; then
    chcon -t container_file_t -R "${REPO_ROOT}/.git" || true
fi

# It is intentional to mount .git only since staged scanning
# and message linting do not require a working tree.
podman run --rm \
    -v "${REPO_ROOT}/.git:/repo/.git:ro" \
    -v "$(realpath "${MSG_FILE}"):/repo/COMMIT_EDITMSG:ro" \
    -w /repo \
    "$IMAGE" \
    commitlint --config /etc/commitlint/commitlint.config.cjs \
    --cwd /repo --edit /repo/COMMIT_EDITMSG
