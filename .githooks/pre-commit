#!/bin/sh
# Blocks commits containing hardcoded secrets via gitleaks.
# Activation: git config core.hooksPath .githooks

set -e

IMAGE="docker.io/zricethezav/gitleaks:v8.30.1"
REPO_ROOT="$(git rev-parse --show-toplevel)"

chcon -t container_file_t -R "${REPO_ROOT}/.git"
chcon -t container_file_t "${REPO_ROOT}/.gitleaks.toml"

podman run --rm \
    -v "${REPO_ROOT}/.git:/repo/.git:ro" \
    -v "${REPO_ROOT}/.gitleaks.toml:/repo/.gitleaks.toml:ro" \
    -w /repo \
    -e GIT_DIR=/repo/.git \
    -e GIT_WORK_TREE=/repo \
    "$IMAGE" \
    protect --staged --redact -v
