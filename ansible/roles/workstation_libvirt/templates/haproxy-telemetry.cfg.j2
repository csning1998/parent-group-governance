# Rendered by workstation_libvirt once workstation_host_telemetry records the scrape IP in local facts.
# Serving the scrape IP from a separate HAProxy process keeps vault-terminator serving the publish Vault API when the scrape bridge is absent.
global
    log stdout format raw local0

defaults
    log global
    timeout connect 5s
    timeout client 300s
    timeout server 300s

# The CLI adds the scrape IP to the SAN of the publish certificate before loading this configuration.
crt-store publish
    load crt "{{ workstation_libvirt_terminator.tls_dir }}/publish.pem" key "{{ workstation_libvirt_terminator.tls_dir }}/publish-key.pem" alias "listener"

frontend host_telemetry_metrics
    mode http
    option httplog
    bind {{ ansible_local.host_telemetry.scrape_address }}:{{ vault_bastion.metrics_port }} ssl crt "@publish/listener" ssl-min-ver TLSv1.3 curves MLKEM1024:SecP384r1MLKEM1024
    http-request deny unless METH_GET { path /v1/sys/metrics }
    default_backend vault_metrics

backend vault_metrics
    mode http
    server vault {{ vault_bastion.loopback_address }}:{{ vault_bastion.metrics_port }} ssl verify required ca-file "{{ workstation_libvirt_terminator.tls_dir }}/ca-ml-dsa-87.pem"
