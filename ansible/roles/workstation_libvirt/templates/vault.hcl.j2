# Rendered by Ansible role workstation_libvirt using listeners defined in workstation-topology.yaml.
ui            = true
api_addr      = "https://{{ bastion_vault.publish_address }}:{{ bastion_vault.api_port }}"
cluster_addr  = "https://{{ bastion_vault.loopback_address }}:{{ bastion_vault.cluster_port }}"
disable_mlock = false

# Unauthenticated generate-root permits break-glass recovery with unseal key quorum after root token revocation.
enable_unauthenticated_access = ["generate-root"]

storage "raft" {
  node_id = "node1"
  path    = "/opt/vault/data"
}

# Loopback listener serves host-local administrative operations, bootstrap routines, and local CLI tooling.
# Clients connecting to the loopback listener verify ML-DSA-87, requiring Go 1.27 or OpenSSL 3.5.
listener "tcp" {
  address       = "{{ bastion_vault.loopback_address }}:{{ bastion_vault.api_port }}"
  tls_disable   = false
  tls_cert_file = "/opt/vault/tls/loopback.pem"
  tls_key_file  = "/opt/vault/tls/loopback-key.pem"
}

# The TLS terminator manages the publish address and forwards guest traffic using PROXY protocol v2.
# This listener binds strictly to loopback, since Vault unconditionally trusts incoming PROXY headers.
listener "tcp" {
  address                 = "{{ bastion_vault.loopback_address }}:{{ bastion_vault.publish_backend_port }}"
  tls_disable             = false
  tls_cert_file           = "/opt/vault/tls/loopback.pem"
  tls_key_file            = "/opt/vault/tls/loopback-key.pem"
  proxy_protocol_behavior = "use_always"
}

# This listener enables tokenless Prometheus metrics scraping. The terminator exposes GET /v1/sys/metrics alone.
listener "tcp" {
  address       = "{{ bastion_vault.loopback_address }}:{{ bastion_vault.metrics_port }}"
  tls_disable   = false
  tls_cert_file = "/opt/vault/tls/loopback.pem"
  tls_key_file  = "/opt/vault/tls/loopback-key.pem"

  telemetry {
    unauthenticated_metrics_access = true
  }
}

# Disabling hostname keeps metric names consistent across Prometheus and Grafana aggregations.
telemetry {
  disable_hostname = true
}
