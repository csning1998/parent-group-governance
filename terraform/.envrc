#!/usr/bin/env bash
# Default operator identity managing Terraform layers in this repository.
# Initial bootstrap of foundation-vault-bastion requires root prior to cert auth role creation.
eval "$(vault-proxy-env administrator)"
export TF_VAR_gitlab_url="${GITLAB_URL:?vault-proxy-env exported no GITLAB_URL}"
export TF_VAR_gitlab_top_level_group_path="${GITLAB_TOP_LEVEL_GROUP_PATH:?vault-proxy-env exported no GITLAB_TOP_LEVEL_GROUP_PATH}"
