#!/usr/bin/env bash

# Terraform operations in this layer MUST authenticate through the local credential-distributor Vault Proxy to enforce scoped mTLS access and resolve state backend credentials.
# Captures vault-proxy-env output before calling eval because evaluating an empty string masks a non-zero exit status.
proxy_env="$(vault-proxy-env credential-distributor-parent-group-governance)"
eval "${proxy_env}"
unset proxy_env
export TF_HTTP_ADDRESS="${GITLAB_TERRAFORM_STATE_BASE:?vault-proxy-env exported no GITLAB_TERRAFORM_STATE_BASE}/administration-gitlab-project"
export TF_HTTP_LOCK_ADDRESS="${TF_HTTP_ADDRESS}/lock"
export TF_HTTP_UNLOCK_ADDRESS="${TF_HTTP_LOCK_ADDRESS}"
export TF_VAR_gitlab_terraform_state_base="${GITLAB_TERRAFORM_STATE_BASE}"
export TF_VAR_gitlab_url="${GITLAB_URL:?vault-proxy-env exported no GITLAB_URL}"
