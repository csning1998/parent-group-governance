#!/usr/bin/env bash

# terraform/.envrc loads the administrator identity, GITLAB_TERRAFORM_STATE_BASE, and the GitLab TF_VAR inputs.
source_up
export TF_HTTP_ADDRESS="${GITLAB_TERRAFORM_STATE_BASE:?vault-proxy-env exported no GITLAB_TERRAFORM_STATE_BASE}/group-ai-provider-anthropic"
export TF_HTTP_LOCK_ADDRESS="${TF_HTTP_ADDRESS}/lock"
export TF_HTTP_UNLOCK_ADDRESS="${TF_HTTP_LOCK_ADDRESS}"
