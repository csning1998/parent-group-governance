# Specifies the maximum number of concurrent job executions globally across all registered runners. This value MAY be increased provided sufficient host system resources are available.
concurrent = 4
check_interval = 0

[[runners]]
  name         = "${runner_name}"
  url          = "https://gitlab.com"
  token        = "${runner_token}"
  executor     = "docker"
  run_untagged = true
  [runners.docker]
    image                        = "alpine:latest"
    host                         = "unix:///run/podman/podman.sock"
    tls_verify                   = false # Disables TLS verification because the local Podman UNIX socket utilizes unencrypted HTTP transport.
    disable_entrypoint_overwrite = false
    oom_kill_disable             = false
    disable_cache                = false
    volumes                      = ["/cache"]
    shm_size                     = 0
    network_mode                 = "sonarqube-ci-net" # Joins the shared bridge network. Job containers reach SonarQube by service name.
